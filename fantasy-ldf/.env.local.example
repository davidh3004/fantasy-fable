# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Supabase — Connect → Connection string.
# DATABASE_URL: transaction pooler (port 6543) — app runtime.
# DIRECT_URL: session pooler (port 5432) — migrations and scripts.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-X-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres

# Public site URL (used for metadata/OG + auth redirects). Set to the
# deployed origin in production, e.g. https://fantasy-ldf.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev test user — used by scripts/create-test-user.ts, perf-check.ts,
# delete-test-user.ts. Never used in production. Choose any password (8+ chars).
TEST_USER_EMAIL=test-user@example.com
TEST_USER_PASSWORD=change-me-min-8-chars

# Sentry error tracking (optional). Leave blank to disable (no-op).
# DSN: Sentry → Project → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps during the production build (CI):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Set to a random secret to enable GET /api/sentry-check?token=... (fires a
# test event to verify Sentry end-to-end). Leave blank to keep the route 404.
SENTRY_CHECK_TOKEN=
